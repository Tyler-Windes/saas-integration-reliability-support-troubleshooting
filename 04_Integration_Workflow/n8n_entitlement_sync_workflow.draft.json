        "jsCode": "const e = $json.event; const required = ['event_id','event_version','event_type','account_id','account_status','support_tier','region','product_family','contract_state','occurred_at']; for (const f of required) if (e[f] === undefined || e[f] === null || e[f] === '') throw new Error('PERMANENT_REQUIRED_FIELD:' + f); const status = (['Suspended','Closed'].includes(e.account_status) || e.contract_state === 'Expired') ? 'DISABLED' : (e.account_status === 'Active' && e.contract_state === 'Current') ? 'ENABLED' : (e.account_status === 'Active' && e.contract_state === 'Pending') ? 'PENDING' : null; const priorities = {Standard:'Normal',Priority:'High',Premium:'Urgent'}; const scope = e.product_family.trim().toUpperCase().replace(/[\\s\\-/]+/g,'_').replace(/^_+|_+$/g,''); if (!status || !priorities[e.support_tier] || !/^[A-Z0-9]+(?:_[A-Z0-9]+)*$/.test(scope)) throw new Error('PERMANENT_UNMAPPABLE'); return [{json:{correlation_id:$json.correlation_id,event:e,target:{account_id:e.account_id,entitlement_status:status,support_priority:priorities[e.support_tier],coverage_region:e.region,product_scope:scope,source_version:e.event_version,correlation_id:$json.correlation_id,last_event_id:e.event_id,updated_at:e.occurred_at}}}];"
